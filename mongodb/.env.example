# Copy this file to mongodb/.env and paste your own SRV connection
# string between the quotes below. .env is gitignored so the password
# never leaves your machine.
#
# To find the URI: log into MongoDB Atlas, open your cluster, click
# "Connect", choose "Drivers", select Python 3.11+, then copy the
# connection string Atlas shows.

MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=NorthStar"
